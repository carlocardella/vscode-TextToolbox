// Place your settings in this file to overwrite default and user settings.
{
    "files.exclude": {
        "out": false // set this to true to hide the "out" folder with the compiled JS files
    },
    "search.exclude": {
        "out": true // set this to false to include "out" folder in search results
    },
    // Turn off tsc task auto detection since we have the necessary tasks as npm scripts
    "typescript.tsc.autoDetect": "off",
    "workbench.colorCustomizations": {
        "activityBar.activeBackground": "#ab307e",
        "activityBar.activeBorder": "#25320e",
        "activityBar.background": "#ab307e",
        "activityBar.foreground": "#e7e7e7",
        "activityBar.inactiveForeground": "#e7e7e799",
        "activityBarBadge.background": "#25320e",
        "activityBarBadge.foreground": "#e7e7e7",
        "statusBar.background": "#832561",
        "statusBar.foreground": "#e7e7e7",
        "statusBarItem.hoverBackground": "#ab307e",
        "titleBar.activeBackground": "#832561",
        "titleBar.activeForeground": "#e7e7e7",
        "titleBar.inactiveBackground": "#83256199",
        "titleBar.inactiveForeground": "#e7e7e799",
        "statusBarItem.remoteBackground": "#121907",
        "statusBarItem.remoteForeground": "#e7e7e7",
        "sash.hoverBorder": "#ab307e",
        "commandCenter.border": "#e7e7e799",
        "tab.activeBorder": "#ab307e",
        "activityBarTop.activeBackground": "#ab307e",
        "activityBarTop.background": "#ab307e",
        "activityBarTop.foreground": "#e7e7e7",
        "activityBarTop.inactiveForeground": "#e7e7e799",
        "commandCenter.foreground": "#e7e7e7",
        "statusBar.debuggingBackground": "#832561",
        "statusBar.debuggingForeground": "#e7e7e7"
    },
    "peacock.color": "#832561",
    "cSpell.words": ["carlocardella", "darkred", "luxon", "pickone", "submenu", "texttoolbox", "untrusted"],
    // TEST EXPLORER - DISABLED for VS Code Extension Tests
    // Use F5 → "Extension Tests" instead
    "mochaExplorer.files": [],
    "testExplorer.codeLens": false,
    "testExplorer.gutterDecoration": false,
    "task.allowAutomaticTasks": "on"
}
